{
  "schema": 1,
  "contract": "1.3",
  "methods": [
    {
      "schema": 1, "id": "pos_cash", "title": "Cash", "kind": "cash", "pos_enabled": true, "order": 0,
      "capture": { "mode": "manual" },
      "capabilities": {
        "amount": { "partial": true }, "change": true, "refunds": { "via": "manual", "partial": true },
        "tips": "none", "offline": "record", "void": true
      },
      "defaults": { "rounding": { "increment": "0.05", "mode": "nearest" }, "open_drawer": true }
    },
    {
      "schema": 1, "id": "pos_card", "title": "Card", "kind": "card", "pos_enabled": true, "order": 1,
      "capture": { "mode": "manual" },
      "capabilities": {
        "amount": { "partial": true }, "change": false, "refunds": { "via": "manual", "partial": true },
        "tips": "none", "offline": "record", "void": true
      },
      "defaults": { "rounding": null, "open_drawer": false }
    },
    {
      "schema": 1, "id": "bacs", "title": "Direct bank transfer", "kind": "other", "pos_enabled": false, "order": 999,
      "capture": { "mode": "webview" },
      "capabilities": {
        "amount": { "partial": false }, "change": false, "refunds": { "via": "manual", "partial": false },
        "tips": "none", "offline": "none", "void": false
      },
      "defaults": { "rounding": null, "open_drawer": false }
    }
  ]
}
